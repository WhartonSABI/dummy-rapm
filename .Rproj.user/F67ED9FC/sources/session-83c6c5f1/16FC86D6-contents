source("scripts/00_functions.R")

pbp_engineered <- read_parquet_tbl("data/02_pbp-lineups-possessions.parquet")
stints <- read_parquet_tbl("data/02_stints.parquet")
qualified <- read_parquet_tbl("data/02_qualified-players-possessions.parquet")$player_id
name_lookup <- get_player_name_lookup(pbp_engineered)

dummy_data <- build_stint_matrices(stints, qualified, use_dummy = TRUE)
no_dummy_data <- build_stint_matrices(stints, qualified, use_dummy = FALSE)

split <- train_test_split_by_row_order(seq_len(nrow(dummy_data$stints)), prop_train = 0.8)

fit_dummy <- fit_eval_ridge(dummy_data$X, dummy_data$y, split$train_idx, split$test_idx, weights = dummy_data$w)
fit_no_dummy <- fit_eval_ridge(no_dummy_data$X, no_dummy_data$y, split$train_idx, split$test_idx, weights = no_dummy_data$w)

perf <- build_perf_with_re(
  c("Dummy", "No Dummy"),
  c(fit_dummy$rmse, fit_no_dummy$rmse),
  c(fit_dummy$r2, fit_no_dummy$r2),
  baseline_model = "No Dummy"
)
print(perf)

player_impact_dummy <- coef_to_table(fit_dummy$model, name_lookup)
player_impact_no_dummy <- coef_to_table(fit_no_dummy$model, name_lookup)

write.csv(perf, "results/04_model-weighted-stint-rapm_performance.csv", row.names = FALSE)
write.csv(player_impact_dummy, "results/04_model-weighted-stint-rapm_dummy-coefs.csv", row.names = FALSE)
write.csv(player_impact_no_dummy, "results/04_model-weighted-stint-rapm_no-dummy-coefs.csv", row.names = FALSE)
