source("scripts/00_functions.R")

pbp_engineered <- read_parquet_tbl("data/02_pbp-lineups-possessions.parquet")
stints <- read_parquet_tbl("data/02_stints.parquet")
qualified <- read_parquet_tbl("data/02_qualified-players-minutes.parquet")$player_id
pbp_engineered <- normalize_lineup_columns(pbp_engineered)
name_lookup <- get_player_name_lookup(pbp_engineered)

player_pairs <- pbp_engineered %>%
  group_by(game_id, possession_id) %>%
  slice_head(n = 1) %>%
  ungroup() %>%
  mutate(home_lineup = lapply(home_lineup, as.character), away_lineup = lapply(away_lineup, as.character)) %>%
  pivot_longer(cols = c(home_lineup, away_lineup), names_to = "side", values_to = "lineup") %>%
  mutate(team = if_else(side == "home_lineup", home_team_id, away_team_id)) %>%
  rowwise() %>%
  mutate(pairs = list(as.data.frame(t(combn(sort(unlist(lineup)), 2))))) %>%
  ungroup() %>%
  unnest(pairs) %>%
  rename(player1 = V1, player2 = V2) %>%
  group_by(team, player1, player2) %>%
  summarise(shared_possessions = n(), .groups = "drop") %>%
  group_by(team) %>%
  slice_max(shared_possessions, n = 1) %>%
  ungroup()

base <- build_stint_matrices(stints, qualified, use_dummy = TRUE)
X <- base$X

pair_matrix <- do.call(cbind, lapply(seq_len(nrow(player_pairs)), function(i) {
  p1 <- as.character(player_pairs$player1[i])
  p2 <- as.character(player_pairs$player2[i])
  col <- sapply(seq_len(nrow(base$stints)), function(j) {
    home <- strsplit(base$stints$home_lineup[j], "\\|")[[1]]
    away <- strsplit(base$stints$away_lineup[j], "\\|")[[1]]
    as.integer((p1 %in% home && p2 %in% home)) - as.integer((p1 %in% away && p2 %in% away))
  })
  matrix(col, ncol = 1, dimnames = list(NULL, paste0("pair_", p1, "_", p2)))
}))

X_int <- cbind(X, pair_matrix)
split <- train_test_split_by_row_order(seq_len(nrow(base$stints)), prop_train = 0.8)

fit_int <- fit_eval_ridge(X_int, base$y, split$train_idx, split$test_idx, weights = base$w)
fit_base <- fit_eval_ridge(X, base$y, split$train_idx, split$test_idx, weights = base$w)

perf <- build_perf_with_re(
  c("Base", "With Interactions"),
  c(fit_base$rmse, fit_int$rmse),
  c(fit_base$r2, fit_int$r2),
  baseline_model = "Base"
)
print(perf)

player_impact <- coef_to_table(fit_int$model, name_lookup)

write.csv(perf, "results/06_model-weighted-stint-interactions-rapm_performance.csv", row.names = FALSE)
write.csv(player_impact, "results/06_model-weighted-stint-interactions-rapm_coefs.csv", row.names = FALSE)
write.csv(player_pairs, "results/06_model-weighted-stint-interactions-rapm_pairs.csv", row.names = FALSE)
