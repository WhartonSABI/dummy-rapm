source("scripts/00_functions.R")

seasons <- c(2024, 2025)

pbp <- load_nba_pbp(seasons) %>%
  filter(season_type == 2, team_id %in% (1:30)) %>%
  arrange(game_date)

write_parquet_tbl(pbp, "data/01_raw-nba-pbp-2024-2025.parquet")
cat("Saved raw PBP to data/01_raw-nba-pbp-2024-2025.parquet with", nrow(pbp), "rows\n")
