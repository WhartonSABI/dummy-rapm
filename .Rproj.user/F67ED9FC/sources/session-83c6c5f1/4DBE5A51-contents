source("scripts/00_functions.R")

pbp_engineered <- read_parquet_tbl("data/02_pbp-lineups-possessions.parquet")
qualified <- read_parquet_tbl("data/02_qualified-players-possessions.parquet")$player_id
name_lookup <- get_player_name_lookup(pbp_engineered)

dummy_data <- build_possession_matrices(pbp_engineered, qualified, use_dummy = TRUE)
no_dummy_data <- build_possession_matrices(pbp_engineered, qualified, use_dummy = FALSE)

n <- length(dummy_data$y)
split <- train_test_split_by_row_order(seq_len(n), prop_train = 0.8)

fit_dummy <- fit_eval_ridge(dummy_data$X, dummy_data$y, split$train_idx, split$test_idx)
fit_no_dummy <- fit_eval_ridge(no_dummy_data$X, no_dummy_data$y, split$train_idx, split$test_idx)

perf <- build_perf_with_re(
  c("Dummy", "No Dummy"),
  c(fit_dummy$rmse, fit_no_dummy$rmse),
  c(fit_dummy$r2, fit_no_dummy$r2),
  baseline_model = "No Dummy"
)
print(perf)

player_impact_dummy <- coef_to_table(fit_dummy$model, name_lookup)
player_impact_no_dummy <- coef_to_table(fit_no_dummy$model, name_lookup)

write.csv(perf, "results/03_model-possession-rapm_performance.csv", row.names = FALSE)
write.csv(player_impact_dummy, "results/03_model-possession-rapm_dummy-coefs.csv", row.names = FALSE)
write.csv(player_impact_no_dummy, "results/03_model-possession-rapm_no-dummy-coefs.csv", row.names = FALSE)

combined_impact <- player_impact_dummy %>%
  inner_join(player_impact_no_dummy, by = "player_id", suffix = c("_dummy", "_no_dummy"))

comparison <- ggplot(combined_impact, aes(x = impact_no_dummy, y = impact_dummy)) +
  geom_point(alpha = 0.6) +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray50") +
  theme_minimal() +
  labs(title = "Player Impact: Dummy vs No Dummy", x = "No Dummy", y = "Dummy")

ggsave("plots/03_model-possession-rapm_dummy-vs-no-dummy-scatter.png", comparison, width = 10, height = 8, dpi = 300)
