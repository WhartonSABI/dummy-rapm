}

build_lineups_and_possessions <- function(play_by_play_data) {
  pbp_small <- play_by_play_data %>%
    select(game_play_number, type_text, text, score_value, team_id, game_id,
           athlete_id_1, athlete_id_2, athlete_id_3, home_team_id, away_team_id,
           start_game_seconds_remaining, away_score, home_score, game_date, season_type) %>%
    arrange(game_date)

  start_five <- pbp_small %>%
    filter(!if_all(c(athlete_id_1, athlete_id_2, athlete_id_3), ~ is.na(.))) %>%
    filter(!if_any(c(team_id, game_id), ~ is.na(.))) %>%
    group_by(game_id, team_id) %>%
    arrange(game_play_number) %>%
    distinct(athlete_id_1, .keep_all = TRUE) %>%
    slice_head(n = 5) %>%
    summarise(starting_five = list(athlete_id_1), .groups = "drop")

  pbp_small <- pbp_small %>%
    left_join(start_five, by = c("game_id", "team_id")) %>%
    group_by(game_id, team_id) %>%
    mutate(starting_five = if_else(row_number() == 1, starting_five, NA)) %>%
    ungroup() %>%
    mutate(starting_five = map(starting_five, ~ if (is.null(.x)) NA else as.character(.x)))

  lineup_changes <- pbp_small %>%
    filter(map_int(starting_five, length) == 5 | type_text == "Substitution") %>%
    arrange(game_id, team_id, game_play_number) %>%
    group_by(game_id, team_id) %>%
    group_split()

  updated_lineup_list <- list()

  for (grp in lineup_changes) {
    n <- nrow(grp)
    updated_lineups <- vector("list", n)

    for (i in seq_len(n)) {
      if (!is.null(grp$starting_five[[i]]) && length(grp$starting_five[[i]]) == 5) {
        updated_lineups[[i]] <- grp$starting_five[[i]]
      } else if (i > 1 && !is.null(updated_lineups[[i - 1]])) {
        updated_lineups[[i]] <- updated_lineups[[i - 1]]
      } else {
        updated_lineups[[i]] <- NA
      }

      if (grp$type_text[i] == "Substitution" &&
          !is.na(grp$athlete_id_1[i]) && !is.na(grp$athlete_id_2[i]) &&
          !all(is.na(updated_lineups[[i]]))) {
        out_player <- grp$athlete_id_2[i]
        in_player <- grp$athlete_id_1[i]
        lineup <- as.character(updated_lineups[[i]])
        idx <- which(lineup == out_player)
        if (length(idx) > 0) {
          lineup[idx] <- in_player
          updated_lineups[[i]] <- lineup
        }
      }
    }

    grp$updated_lineup <- updated_lineups
    updated_lineup_list <- append(updated_lineup_list, list(grp))
  }

  lineup_changes_updated <- bind_rows(updated_lineup_list)

  pbp_small <- pbp_small %>%
    left_join(
      lineup_changes_updated %>% select(game_id, team_id, game_play_number, updated_lineup),
      by = c("game_id", "team_id", "game_play_number")
    ) %>%
    group_by(game_id, team_id) %>%
    tidyr::fill(updated_lineup, .direction = "down") %>%
    ungroup() %>%
    mutate(
      home_lineup = case_when(team_id == home_team_id ~ updated_lineup, TRUE ~ NA),
      away_lineup = case_when(team_id == away_team_id ~ updated_lineup, TRUE ~ NA)
    ) %>%
    group_by(game_id) %>%
    tidyr::fill(home_lineup, away_lineup, .direction = "down") %>%
    tidyr::fill(home_lineup, away_lineup, .direction = "up") %>%
    ungroup() %>%
    mutate(
      possession_end = case_when(
        score_value > 0 & grepl("Shot|Dunk|Layup", type_text) ~ TRUE,
        type_text == "Defensive Rebound" ~ TRUE,
        type_text %in% c("Free Throw - 1 of 1", "Free Throw - 2 of 2", "Free Throw - 3 of 3",
                         "Free Throw - Flagrant 1 of 1", "Free Throw - Flagrant 2 of 2",
                         "Free Throw - Flagrant 3 of 3", "Free Throw - Clear Path 2 of 2") & score_value > 0 ~ TRUE,
        grepl("Turnover", type_text) & type_text != "No Turnover" ~ TRUE,
        TRUE ~ FALSE
      )
    ) %>%
    group_by(game_id) %>%
    mutate(
      # Assign each end-event to the possession it closes (not the next one).
      possession_id = lag(cumsum(possession_end), default = 0L) + 1L
    ) %>%
    ungroup()

  pbp_small
}

get_qualified_players_possessions <- function(pbp_small, min_possessions = 1000) {
  pbp_small <- normalize_lineup_columns(pbp_small)
  pbp_small %>%
    group_by(game_id, possession_id) %>%
    slice_head(n = 1) %>%
    ungroup() %>%
    mutate(home_lineup = lapply(home_lineup, as.character), away_lineup = lapply(away_lineup, as.character)) %>%
    rowwise() %>%
    mutate(all_players = list(c(home_lineup, away_lineup))) %>%
    ungroup() %>%
    unnest(all_players) %>%
    group_by(all_players) %>%
    summarise(total_possessions = n(), .groups = "drop") %>%
    filter(total_possessions >= min_possessions) %>%
    pull(all_players)
}

get_qualified_players_minutes <- function(pbp_small, min_median_minutes = 10, min_games = 20) {
  pbp_small <- normalize_lineup_columns(pbp_small)
  player_game_seconds <- pbp_small %>%
    filter(possession_end) %>%
    group_by(game_id) %>%
    arrange(game_play_number) %>%
    mutate(
      prev_seconds_remaining = lag(start_game_seconds_remaining, default = 2880),
      possession_duration = prev_seconds_remaining - start_game_seconds_remaining
    ) %>%
    ungroup() %>%
    mutate(home_lineup = lapply(home_lineup, as.character), away_lineup = lapply(away_lineup, as.character)) %>%
    rowwise() %>%
    mutate(all_players = list(c(home_lineup, away_lineup))) %>%
    ungroup() %>%
    unnest(all_players) %>%
    group_by(game_id, all_players) %>%
    summarise(total_seconds = sum(possession_duration, na.rm = TRUE), .groups = "drop") %>%
    mutate(total_minutes = total_seconds / 60)

  player_game_seconds %>%
    group_by(all_players) %>%
    summarise(games_played = n(), median_minutes = median(total_minutes, na.rm = TRUE), .groups = "drop") %>%
    filter(median_minutes >= min_median_minutes, games_played > min_games) %>%
    pull(all_players)
}

add_dummy_players <- function(pbp_small, qualified_players, n_dummy = 5) {
  pbp_small <- normalize_lineup_columns(pbp_small)
  dummy_ids <- as.character(seq_len(n_dummy))
  pbp_small %>%
    mutate(
      home_lineup = map(home_lineup, ~ ifelse(as.character(.x) %in% qualified_players, as.character(.x), dummy_ids[1])),
      away_lineup = map(away_lineup, ~ ifelse(as.character(.x) %in% qualified_players, as.character(.x), dummy_ids[2]))
    )
}

build_possession_matrices <- function(pbp_small, qualified_players, use_dummy = TRUE) {
  pbp_small <- normalize_lineup_columns(pbp_small)
  data <- if (use_dummy) add_dummy_players(pbp_small, qualified_players) else pbp_small

  possession_lineups <- data %>%
    mutate(home_lineup = lapply(home_lineup, as.character), away_lineup = lapply(away_lineup, as.character)) %>%
    group_by(game_id, possession_id) %>%
    slice_head(n = 1) %>%
    ungroup()

  all_players <- if (use_dummy) {
    sort(unique(c(unlist(possession_lineups$home_lineup), unlist(possession_lineups$away_lineup))))
  } else {
    sort(unique(qualified_players))
  }

  X <- do.call(rbind, lapply(seq_len(nrow(possession_lineups)), function(i) {
    home <- possession_lineups$home_lineup[[i]]
    away <- possession_lineups$away_lineup[[i]]
    as.integer(all_players %in% home) - as.integer(all_players %in% away)
  }))
  colnames(X) <- all_players

  y <- data %>%
    group_by(game_id, possession_id) %>%
    summarise(
      home_points = sum(score_value[team_id == first(home_team_id)], na.rm = TRUE),
      away_points = sum(score_value[team_id == first(away_team_id)], na.rm = TRUE),
      net_points = home_points - away_points,
      .groups = "drop"
    ) %>%
    pull(net_points)

  list(X = X, y = y, group_data = data)
}

build_stints <- function(pbp_small) {
  pbp_small <- normalize_lineup_columns(pbp_small)
  tmp <- pbp_small %>%
    mutate(
      home_lineup_key = sapply(home_lineup, function(x) paste(sort(trimws(as.character(x[!is.na(x)]))), collapse = "|")),
      away_lineup_key = sapply(away_lineup, function(x) paste(sort(trimws(as.character(x[!is.na(x)]))), collapse = "|")),
      lineup_pair = paste(home_lineup_key, away_lineup_key, sep = "||")
    ) %>%
    mutate(
      lineup_change = lineup_pair != lag(lineup_pair, default = first(lineup_pair)),
      stint_id = cumsum(lineup_change)
    )

  tmp %>%
    group_by(game_id, stint_id) %>%
    summarise(
      home_lineup = first(home_lineup_key),
      away_lineup = first(away_lineup_key),
      n_possessions = sum(possession_end, na.rm = TRUE),
      start_points_home = first(home_score),
      end_points_home = last(home_score),
      start_points_away = first(away_score),
      end_points_away = last(away_score),
      game_date = first(game_date),
      .groups = "drop"
    ) %>%
    mutate(home_net_points = (end_points_home - start_points_home) - (end_points_away - start_points_away)) %>%
    filter(n_possessions > 0) %>%
    arrange(game_date, stint_id)
}

build_stint_matrices <- function(stints, qualified_players, use_dummy = TRUE) {
  if (use_dummy) {
    dummy_ids <- as.character(1:5)
    stints <- stints %>%
      mutate(
        home_lineup = sapply(strsplit(home_lineup, "\\|"), function(v) paste(ifelse(v %in% qualified_players, v, dummy_ids[1]), collapse = "|")),
        away_lineup = sapply(strsplit(away_lineup, "\\|"), function(v) paste(ifelse(v %in% qualified_players, v, dummy_ids[2]), collapse = "|"))
      )
  }

  y <- stints$home_net_points
  w <- stints$n_possessions

  all_players <- if (use_dummy) {
    sort(unique(c(unlist(strsplit(stints$home_lineup, "\\|")), unlist(strsplit(stints$away_lineup, "\\|")))))
  } else {
    sort(unique(qualified_players))
  }

  X <- do.call(rbind, lapply(seq_len(nrow(stints)), function(i) {
    home <- strsplit(stints$home_lineup[i], "\\|")[[1]]
    away <- strsplit(stints$away_lineup[i], "\\|")[[1]]
    as.integer(all_players %in% home) - as.integer(all_players %in% away)
  }))
  colnames(X) <- all_players

  list(X = X, y = y, w = w, stints = stints)
}

train_test_split_by_row_order <- function(row_sequence, prop_train = 0.8) {
  n <- length(row_sequence)
  train_n <- floor(n * prop_train)
  list(train_idx = seq_len(train_n), test_idx = seq(train_n + 1, n))
}

fit_eval_ridge <- function(X, y, train_idx, test_idx, weights = NULL) {
  if (is.null(weights)) {
    model <- cv.glmnet(X[train_idx, , drop = FALSE], y[train_idx], alpha = 0)
  } else {
    model <- cv.glmnet(X[train_idx, , drop = FALSE], y[train_idx], alpha = 0, weights = weights[train_idx])
  }

  pred <- as.vector(predict(model, newx = X[test_idx, , drop = FALSE], s = "lambda.min"))
  actual <- y[test_idx]

  list(
    model = model,
    rmse = sqrt(mean((actual - pred)^2)),
    r2 = r_squared(actual, pred),
    pred = pred,
    actual = actual
  )
}

coef_to_table <- function(model_obj, name_lookup) {
  coefs <- coef(model_obj, s = "lambda.min")
  tibble(player_id = rownames(coefs)[-1], impact = as.vector(coefs)[-1]) %>%
    arrange(desc(impact)) %>%
    left_join(name_lookup, by = c("player_id" = "athlete_id_1"))
}
