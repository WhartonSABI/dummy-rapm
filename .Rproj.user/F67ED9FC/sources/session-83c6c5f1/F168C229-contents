lineup_list_to_str <- function(x) {
  vapply(x, function(e) {
    if (is.null(e) || all(is.na(e))) return(NA_character_)
    paste(as.character(e[!is.na(e)]), collapse = "|")
  }, character(1))
}

lineup_str_to_list <- function(x) {
  lapply(x, function(e) {
    if (is.na(e) || !nzchar(e)) return(NA_character_)
    strsplit(as.character(e), "\\|")[[1]]
  })
}

normalize_lineup_columns <- function(df) {
  for (col in c("starting_five", "updated_lineup", "home_lineup", "away_lineup")) {
    if (col %in% names(df) && !is.list(df[[col]])) {
      df[[col]] <- lineup_str_to_list(df[[col]])
    }
  }
  df
}

r_squared <- function(actual, predicted) {
  ss_res <- sum((actual - predicted)^2)
  ss_tot <- sum((actual - mean(actual))^2)
  1 - (ss_res / ss_tot)
}

build_perf_with_re <- function(model_names, rmse_values, r2_values, baseline_model) {
  perf <- tibble(model = model_names, RMSE = rmse_values, R2 = r2_values)
  baseline_rmse <- perf$RMSE[match(baseline_model, perf$model)]
  perf %>%
    mutate(RE = (baseline_rmse - RMSE) / baseline_rmse) %>%
    select(model, RMSE, RE, R2)
}

get_player_name_lookup <- function(pbp) {
  pbp %>%
    filter(!is.na(athlete_id_1), !is.na(text), str_detect(type_text, "Free Throw")) %>%
