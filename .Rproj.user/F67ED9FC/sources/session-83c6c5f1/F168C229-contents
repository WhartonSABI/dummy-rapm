load_required_packages <- function() {
  libs <- c("dplyr", "glmnet", "tidyr", "hoopR", "purrr", "zoo", "Matrix", "ggplot2", "stringr", "arrow")
  missing <- libs[!vapply(libs, requireNamespace, quietly = TRUE, FUN.VALUE = logical(1))]
  if (length(missing) > 0) {
    stop(
      paste0(
        "Missing required packages: ",
        paste(missing, collapse = ", "),
        ". Install them before running the pipeline."
      )
    )
  }
  invisible(lapply(libs, function(pkg) suppressPackageStartupMessages(library(pkg, character.only = TRUE))))
}

load_required_packages()
