# ── Top 10 rhos across all players ───────────────────────────────────────────
min_games <- 40
compute_rho <- function(player) {
d <- box_raw |>
filter(athlete_display_name == player) |>
transmute(points = as.numeric(points), rebounds = as.numeric(rebounds)) |>
filter(!is.na(points), !is.na(rebounds))
if (nrow(d) < min_games) return(NA_real_)
tryCatch({
eps <- 1e-6
u1  <- pmin(pmax(pnorm(d$points,   mean(d$points),   sd(d$points)),   eps), 1 - eps)
u2  <- pmin(pmax(pnorm(d$rebounds, mean(d$rebounds),  sd(d$rebounds)), eps), 1 - eps)
cor(qnorm(u1), qnorm(u2))
}, error = function(e) NA_real_)
}
players <- unique(box_raw$athlete_display_name)
rhos    <- sapply(players, compute_rho)
top10 <- sort(rhos, decreasing = TRUE)[1:10]
print(round(data.frame(player = names(top10), rho = top10), 4), row.names = FALSE)
top10
print(data.frame(player = names(top10), rho = round(top10, 4)), row.names = FALSE)
top10 <- sort(rhos, decreasing = TRUE)[1:20]
print(data.frame(player = names(top10), rho = round(top10, 4)), row.names = FALSE)
player_name <- "Adem Bona"
df <- box_raw |>
filter(athlete_display_name == player_name) |>
transmute(points = as.numeric(points), rebounds = as.numeric(rebounds)) |>
filter(!is.na(points), !is.na(rebounds)) |>
as.data.frame()
fit_pts <- MASS::fitdistr(df$points,   "normal")
fit_reb <- MASS::fitdistr(df$rebounds, "normal")
mu_pts <- fit_pts$estimate["mean"]; sd_pts <- fit_pts$estimate["sd"]
mu_reb <- fit_reb$estimate["mean"]; sd_reb <- fit_reb$estimate["sd"]
eps <- 1e-6
u1  <- pmin(pmax(pnorm(df$points,   mu_pts, sd_pts), eps), 1 - eps)
u2  <- pmin(pmax(pnorm(df$rebounds, mu_reb, sd_reb), eps), 1 - eps)
rho <- cor(qnorm(u1), qnorm(u2))
sig <- matrix(c(1, rho, rho, 1), 2, 2)
query_prob <- function(pts_threshold, reb_threshold) {
F_x <- pnorm(pts_threshold, mu_pts, sd_pts)
F_y <- pnorm(reb_threshold, mu_reb, sd_reb)
p_pts    <- 1 - F_x
p_reb    <- 1 - F_y
p_indep  <- p_pts * p_reb
C_joint  <- pmvnorm(upper = c(qnorm(F_x), qnorm(F_y)), sigma = sig)[1]
p_copula <- max(1 - F_x - F_y + C_joint, 0)
cat(sprintf("\nP(Points >= %g)        : %.4f\n", pts_threshold, p_pts))
cat(sprintf("P(Rebounds >= %g)      : %.4f\n",  reb_threshold, p_reb))
cat(sprintf("P(Both) independence   : %.4f\n",  p_indep))
cat(sprintf("P(Both) copula         : %.4f\n",  p_copula))
}
query_prob(10, 6)
rho
query_prob(6, 6)
rho
library(hoopR)
library(mvtnorm)
library(dplyr)
library(MASS)
seasons <- c(2024, 2025)
box_raw <- hoopR::load_nba_player_box(seasons = seasons) |>
filter(season_type == 2) |>
filter(starter = =TRUE)
library(hoopR)
library(mvtnorm)
library(dplyr)
library(MASS)
seasons <- c(2024, 2025)
box_raw <- hoopR::load_nba_player_box(seasons = seasons) |>
filter(season_type == 2) |>
filter(starter == TRUE)
# ── Top 10 rhos across all players ───────────────────────────────────────────
min_games <- 40
compute_rho <- function(player) {
d <- box_raw |>
filter(athlete_display_name == player) |>
transmute(points = as.numeric(points), rebounds = as.numeric(rebounds)) |>
filter(!is.na(points), !is.na(rebounds))
if (nrow(d) < min_games) return(NA_real_)
tryCatch({
eps <- 1e-6
u1  <- pmin(pmax(pnorm(d$points,   mean(d$points),   sd(d$points)),   eps), 1 - eps)
u2  <- pmin(pmax(pnorm(d$rebounds, mean(d$rebounds),  sd(d$rebounds)), eps), 1 - eps)
cor(qnorm(u1), qnorm(u2))
}, error = function(e) NA_real_)
}
players <- unique(box_raw$athlete_display_name)
rhos    <- sapply(players, compute_rho)
top10 <- sort(rhos, decreasing = TRUE)[1:20]
print(data.frame(player = names(top10), rho = round(top10, 4)), row.names = FALSE)
player_name <- "Zach Edey"
df <- box_raw |>
filter(athlete_display_name == player_name) |>
transmute(points = as.numeric(points), rebounds = as.numeric(rebounds)) |>
filter(!is.na(points), !is.na(rebounds)) |>
as.data.frame()
fit_pts <- MASS::fitdistr(df$points,   "normal")
fit_reb <- MASS::fitdistr(df$rebounds, "normal")
mu_pts <- fit_pts$estimate["mean"]; sd_pts <- fit_pts$estimate["sd"]
mu_reb <- fit_reb$estimate["mean"]; sd_reb <- fit_reb$estimate["sd"]
eps <- 1e-6
u1  <- pmin(pmax(pnorm(df$points,   mu_pts, sd_pts), eps), 1 - eps)
u2  <- pmin(pmax(pnorm(df$rebounds, mu_reb, sd_reb), eps), 1 - eps)
rho <- cor(qnorm(u1), qnorm(u2))
sig <- matrix(c(1, rho, rho, 1), 2, 2)
query_prob <- function(pts_threshold, reb_threshold) {
F_x <- pnorm(pts_threshold, mu_pts, sd_pts)
F_y <- pnorm(reb_threshold, mu_reb, sd_reb)
p_pts    <- 1 - F_x
p_reb    <- 1 - F_y
p_indep  <- p_pts * p_reb
C_joint  <- pmvnorm(upper = c(qnorm(F_x), qnorm(F_y)), sigma = sig)[1]
p_copula <- max(1 - F_x - F_y + C_joint, 0)
cat(sprintf("\nP(Points >= %g)        : %.4f\n", pts_threshold, p_pts))
cat(sprintf("P(Rebounds >= %g)      : %.4f\n",  reb_threshold, p_reb))
cat(sprintf("P(Both) independence   : %.4f\n",  p_indep))
cat(sprintf("P(Both) copula         : %.4f\n",  p_copula))
}
query_prob(6, 6)
rho
query_prob(10, 10)
rho
library(ggplot2)
library(ggExtra)
install.packages(ggExtra)
p <- ggplot(df, aes(x = points, y = rebounds)) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm", se = FALSE, colour = "steelblue") +
labs(title = paste(player_name, "— rho =", round(rho, 3)),
x = "Points", y = "Rebounds") +
theme_minimal()
ggMarginal(p, type = "histogram", fill = "steelblue", alpha = 0.5)
